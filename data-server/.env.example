# ============================================================================
# AuditSphere Data Hub — Environment Variables
# Copy to .env and fill in actual values before docker compose up
# ============================================================================

# --- PostgreSQL: CBS Simulator ---
CBS_POSTGRES_USER=postgres
CBS_POSTGRES_PASSWORD=CHANGE_ME_cbs_strong_password_here
CBS_POSTGRES_DB=cbs_simulator

# --- PostgreSQL: Data Lake ---
DATALAKE_POSTGRES_USER=postgres
DATALAKE_POSTGRES_PASSWORD=CHANGE_ME_datalake_strong_password_here
DATALAKE_POSTGRES_DB=auditsphere_datalake

# --- Data Lake Roles ---
ETL_USER_PASSWORD=CHANGE_ME_etl_password_here
AUDITOR_AI_PASSWORD=CHANGE_ME_auditor_password_here
DATAHUB_API_PASSWORD=CHANGE_ME_datahub_api_password_here

# --- Data Hub API ---
DATA_HUB_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
DATA_HUB_PORT=8100

# --- AI Engine ---
AI_ENGINE_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
AI_ENGINE_PORT=8006

# --- Nginx / JupyterLab ---
JUPYTER_TOKEN=CHANGE_ME_jupyter_token_here
NGINX_PORT=80

# --- WireGuard VPN ---
WG_SERVER_PRIVATE_KEY=CHANGE_ME_server_private_key
WG_CLIENT_PUBLIC_KEY=CHANGE_ME_client_public_key
WG_SERVER_ADDRESS=10.0.0.1/24
WG_SERVER_PORT=51820

# --- Audit Server (for sync reference) ---
AUDIT_SERVER_VPN_IP=10.0.0.2
AUDIT_SERVER_PUBLIC_IP=202.10.34.166
