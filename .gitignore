# Dependencies
node_modules/
vendor/

# Google Drive credentials
gdrive-credentials.json

# Environment variables
.env
.env.local

# Per-tenant signing secrets, written by scripts/generate-tenant-stack.sh.
# Covered by the `.env` rule above; spelled out so it is not lost if that rule
# is ever narrowed. The generated docker-compose.yml and kong.yml next to these
# hold no secrets and are meant to be committed.
backend/tenants/*/.env

# OS files
.DS_Store
Thumbs.db

# Large binaries and archives
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.rar
*.bz2
*.safetensors
*.bin
*.iso
*.dmg
*.pkl
*.pth
**/model/

# Build artifacts & caches
.output/
.nuxt/
dist/
build/
backend/auth-service/auth
backend/audit-service/audit
backend/master-service/master
backend/risk-service/risk
backend/analytics-service/analytics

# Database dumps & local storage
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Logs
*.log
logs/

# Executables
*.exe

# Postgres CA / client certs mounted read-only into backend containers
# (docker-compose.prod.yml -> /etc/rb-audit/pg-ca). Only .gitkeep is tracked.
backend/pg-ca/*
!backend/pg-ca/.gitkeep

# Python bytecode
__pycache__/
*.pyc

# Local sample DB TLS material (never commit keys)
local-sample-db/certs/
data-server/local-sample-db/certs/
