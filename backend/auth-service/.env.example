# Server Configuration
SERVER_PORT=8001
SERVER_MODE=release
SERVER_READ_TIMEOUT=60

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rb_audit
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOUR=24

# MFA secret encryption at rest (AES-256-GCM, stored as enc:v1:...)
# 32 random bytes, base64. Generate: openssl rand -base64 32
# One key per deployment/tenant. Never reuse it, never derive it from JWT_SECRET.
# Losing the key makes every encrypted TOTP secret unreadable (users must re-enrol MFA).
MFA_ENCRYPTION_KEY=
# Optional, during a rotation only: previous key(s), comma separated, decrypt-only.
# Run `auth migrate encrypt-mfa-secrets` after rotating, then remove this.
MFA_ENCRYPTION_KEY_OLD=
# true = refuse to start without MFA_ENCRYPTION_KEY. Implied by APP_APP_ENV=production.
MFA_ENCRYPTION_REQUIRED=false

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Resend Email Configuration (Recommended - Purely wired via REST API)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_MASTER_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="AuditSphere <no-reply@mail.auditsphere.app>"
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP Configuration (Fallback only)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM="AuditSphere <no-reply@mail.auditsphere.app>"
