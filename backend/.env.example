# JWT Signing Secret (minimum 64 characters)
# Shared across all services in the rb_audit stack
JWT_SECRET=6958c455ba7378688fac7200001d6bca8048fa66a28447ecc69f3b74b7ded4fa

# auth-service only: encrypts MFA TOTP secrets at rest. 32 random bytes, base64:
#   openssl rand -base64 32
# One key per stack/tenant; unrelated to JWT_SECRET. Required (start-up fails
# without it) when MFA_ENCRYPTION_REQUIRED=true or APP_APP_ENV=production.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_OLD=
MFA_ENCRYPTION_REQUIRED=false

# AI & Data Hub
PYTHON_AI_URL=http://python-ai:8000
PYTHON_AI_API_KEY=dev-ai-api-key
DATA_HUB_URL=http://10.0.0.1:8100
DATA_HUB_API_KEY=dev-api-key
