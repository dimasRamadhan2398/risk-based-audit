# /etc/auditsphere/provisioner.env  (root:root, chmod 600, never committed)
#
# Environment for /opt/auditsphere/provisioner, loaded by
# deploy/provisioner/auditsphere-provisioner.service.

# Listen address. The docker0 bridge gateway, so the control-plane auth-service
# container reaches it as http://host.docker.internal:8790 (extra_hosts
# host-gateway in backend/docker-compose.prod.yml). Loopback or a private
# address only; the binary refuses 0.0.0.0 and public IPs. Check the bridge IP
# with: ip -4 addr show docker0
PROVISIONER_ADDR=172.17.0.1:8790

# Shared secret with auth-service (PROVISIONER_TOKEN in backend/.env). At least
# 32 characters. Generate with: openssl rand -hex 32
PROVISIONER_TOKEN=

# The repository checkout that holds scripts/onboard-tenant.sh and
# backend/tenants/registry.tsv. The tenant images are built from the prebuilt
# artifacts in this checkout (backend/*-service/<binary>, frontend/.output).
PROVISIONER_REPO_DIR=/app/rbia-repo

# Jobs and event logs. Matches StateDirectory= in the unit.
PROVISIONER_DATA_DIR=/var/lib/auditsphere/provisioner

# Optional.
# PROVISIONER_BASH=/bin/bash

# Read by scripts/onboard-tenant.sh, which inherits this environment.
# AUDITSPHERE_EMAIL_ENV=/etc/auditsphere/email.env   # Resend master key (step 6)
# BASE_DOMAIN=auditsphere.app                        # when a job gives no domain
