@echo off
title Launching AuditSphere System & AI Service...
echo ==========================================================
echo   Starting AuditSphere All-in-One Services...
echo ==========================================================

echo [1/3] Launching Python AI Microservice (Port 8000)...
start "AuditSphere Python AI Service (Port 8000)" cmd /k "cd /d %~dp0backend\python-ai && python main.py"

echo [2/3] Launching Analytics Go Microservice (Port 8084)...
start "AuditSphere Analytics Service (Port 8084)" cmd /k "cd /d %~dp0backend\analytics-service && go run ./cmd/main.go"

echo [3/3] Launching Frontend Nuxt Application (Port 3000)...
cd /d %~dp0frontend
npm run dev
